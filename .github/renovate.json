{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    "helpers:pinGitHubActionDigests"
  ],
  "dependencyDashboard": false,
  "prHourlyLimit": 0,
  "prConcurrentLimit": 0,
  "automerge": true,
  "automergeType": "pr",
  "ignoreTests": true,
  "packageRules": [
    {
      "description": "Generated by gh aw compile from the .md sources; must not be updated by hand",
      "matchFileNames": [".github/workflows/*.lock.yml"],
      "enabled": false
    }
  ]
}
